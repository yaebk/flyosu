# environments
.venv/
__pycache__/
*.pyc

# raw connectome data (fetched by `make data`, ~130 MB) and derived caches
data/Connectivity_783.parquet
data/neuron_annotations.tsv
data/flywire783_cache.npz
data/flywire783_ann.parquet
data/models/

# session scratch
scratch/

# male CNS raw data (fetched from the public FlyEM bucket, ~1.1 GB)
data/malecns/*.feather
data/malecns/*.npz
data/malecns/*.parquet

# per-shard checkpoints from parallel runs; `merge` folds them into the
# canonical results file, so they are intermediate rather than data
results/*_shard*of*.json

# the replay page's sound, extracted from the map archive in osumaps/ by
# `python experiments/demo_replay.py audio`; no need for a second copy
demo/audio.ogg
demo/song_*.ogg
demo/*.wav
demo/replay_build.json

# beatmap archives contain the songs; download them as listed in osumaps/README.md
osumaps/*.osz
